# Copy to .env on the NAS and fill in. .env is in .gitignore: never commit real values.
# The NAS's own LAN address, the one the local dispatcher connects to.
LAN_ADDRESS=<NAS LAN address>
# The GitHub App's id (App settings, "About").
APP_ID=<app id>
# Public NKeys (they start with U), from `node scripts/nkey.js` (README, "Deploying").
RECEIVER_NKEY=<receiver public NKey>
CLOUD_NKEY=<cloud public NKey>
# Any long random string. Nobody uses it: LAN connections log in with no credentials.
LAN_UNUSED_PASSWORD=<random>
