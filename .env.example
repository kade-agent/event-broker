# `docker compose run --rm setup` copies this to .env and fills in what it can. .env is in .gitignore.
# The NAS's own LAN address, the one the local dispatcher connects to.
LAN_ADDRESS=<NAS LAN address>
# The GitHub App's id (App settings, "About").
APP_ID=<app id>
# Owners whose deliveries the receiver accepts, comma-separated; others get 204. The receiver refuses to
# start without it.
ALLOWED_OWNERS=kade-k8s-platform,kade-agent,stella-rain,star-resonance
# Workflows built to end red on main, comma-separated <owner>/<repo>:<workflow name> (decision 32): their
# runs on main are main_info, never main_failed or red, and never wake the dispatcher. Empty is none.
MAIN_INFO_WORKFLOWS=
# Written by `docker compose run --rm setup` (README, "Deploying"): for each owner above, public NKeys
# RECEIVER_NKEY_<OWNER> and READER_NKEY_<OWNER> (U..., 56 characters; the owner in upper case, "-" as
# "_"), derived from the seeds in secrets/. Never paste a seed (SU...) here; run the setup again instead.
